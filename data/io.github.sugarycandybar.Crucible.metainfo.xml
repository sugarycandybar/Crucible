<?xml version="1.0" encoding="UTF-8"?>
<component type="desktop-application">
  <id>io.github.sugarycandybar.Crucible</id>
  <name>Crucible</name>
  <summary>View specs and stress test hardware</summary>
  <metadata_license>CC0-1.0</metadata_license>
  <project_license>GPL-3.0-or-later</project_license>
  <developer id="io.github.sugarycandybar">
    <name>Sugarycandybar</name>
  </developer>
  <update_contact>candybaralt@gmail.com</update_contact>
  <description>
    <p>
      Crucible gives you a clear overview of your system hardware and lets you
      push it to its limits with built-in stress testing.
    </p>
    <ul>
      <li>View CPU, GPU, and memory details at a glance</li>
      <li>Run CPU or GPU stress tests</li>
      <li>Copy a spec sheet to share with others</li>
      <li>Monitor temperature and usage in real time</li>
      <li>Automatic safety cutoff when temperatures get too high</li>
    </ul>
  </description>
  <categories>
    <category>System</category>
    <category>Monitor</category>
  </categories>
  <keywords>
    <keyword>hardware</keyword>
    <keyword>specs</keyword>
